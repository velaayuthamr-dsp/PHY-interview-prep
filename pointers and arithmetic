#include <stdio.h>

int main(void) {
    int a[5] = {10, 20, 30, 40, 50};
    int *p = a;

    // SECTION 1
    printf("SECTION 1: 8 access methods for a[2]\n");
    printf("%d %d %d %d %d %d %d %d\n",
           a[2], *(a+2), *(2+a), 2[a],
           p[2], *(p+2), *(2+p), 2[p]);

    // SECTION 2
    printf("\nSECTION 2: Pointer arithmetic\n");
    printf("p     = %p\n", (void*)p);
    printf("p+1   = %p\n", (void*)(p+1));
    printf("p+2   = %p\n", (void*)(p+2));
    printf("*(p+1) = %d\n", *(p+1));

    // SECTION 3
    printf("\nSECTION 3: Increment traps\n");

    p = a; a[0] = 10;
    printf("*p++   = %d\n", *p++);

    p = a;
    printf("*++p   = %d\n", *++p);

    p = a; a[0] = 10;
    printf("(*p)++ = %d\n", (*p)++);

    p = a; a[0] = 10;
    printf("++*p   = %d\n", ++*p);

    // SECTION 4
    printf("\nSECTION 4: sizeof\n");
    printf("sizeof(a)     = %zu\n", sizeof(a));
    printf("sizeof(p)     = %zu\n", sizeof(p));
    printf("sizeof(*p)    = %zu\n", sizeof(*p));
    printf("sizeof(&a)    = %zu\n", sizeof(&a));
    printf("sizeof(&a[0]) = %zu\n", sizeof(&a[0]));

    // SECTION 5
    printf("\nSECTION 5: &a vs &a[0]\n");
    printf("a          = %p\n", (void*)a);
    printf("&a[0]      = %p\n", (void*)&a[0]);
    printf("&a         = %p\n", (void*)&a);
    printf("a+1        = %p\n", (void*)(a+1));
    printf("&a[0]+1    = %p\n", (void*)(&a[0]+1));
    printf("&a+1       = %p\n", (void*)(&a+1));
    printf("Byte diff (a+1 - a)     = %ld\n", (long)((char*)(a+1) - (char*)a));
    printf("Byte diff (&a+1 - &a)   = %ld\n", (long)((char*)(&a+1) - (char*)&a));

    return 0;
}
